<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource>
        <!-- Main QML files -->
        <file>qml/main.qml</file>
        <file>qml/HomePage.qml</file>
        <file>qml/SearchPage.qml</file>
        <file>qml/MovieDetail.qml</file>
        <file>qml/PlayerPage.qml</file>
        <file>qml/SeriesPage.qml</file>
        <file>qml/SeriesDetail.qml</file>
        <file>qml/SeriesSearchPage.qml</file>

        <!-- Components -->
        <file>qml/components/MovieCard.qml</file>
        <file>qml/components/MovieGrid.qml</file>
        <file>qml/components/SearchBar.qml</file>
        <file>qml/components/ProgressBar.qml</file>

        <!-- Assets -->
        <file alias="assets/images/output-estesi.png">src/assets/images/output-estesi.png</file>
    </qresource>
</RCC>
