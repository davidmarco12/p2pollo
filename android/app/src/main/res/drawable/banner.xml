<?xml version="1.0" encoding="utf-8"?>
<!-- Banner 320x180dp para Android TV Leanback Launcher -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo oscuro -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0908" />
        </shape>
    </item>
    <!-- Barra naranja izquierda (identidad visual) -->
    <item android:right="288dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF6B35" />
        </shape>
    </item>
    <!-- Círculo naranja central decorativo -->
    <item
        android:bottom="50dp"
        android:left="48dp"
        android:right="200dp"
        android:top="50dp">
        <shape android:shape="oval">
            <solid android:color="#FF6B35" />
        </shape>
    </item>
</layer-list>
